{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/vercel-build.mjs",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/dashboard",
      "destination": "https://rached-chakchouk.netlify.app/dashboard/",
      "permanent": false
    },
    {
      "source": "/dashboard/",
      "destination": "https://rached-chakchouk.netlify.app/dashboard/",
      "permanent": false
    },
    {
      "source": "/dashboard/:path+",
      "destination": "https://rached-chakchouk.netlify.app/dashboard/",
      "permanent": false
    },
    {
      "source": "/dashborad",
      "destination": "https://rached-chakchouk.netlify.app/dashboard/",
      "permanent": false
    },
    {
      "source": "/dashborad/",
      "destination": "https://rached-chakchouk.netlify.app/dashboard/",
      "permanent": false
    },
    {
      "source": "/admin",
      "destination": "https://rached-chakchouk.netlify.app/dashboard/",
      "permanent": false
    },
    {
      "source": "/admin/",
      "destination": "https://rached-chakchouk.netlify.app/dashboard/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/media/:name",
      "destination": "/api/media?name=:name"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; form-action 'self'; manifest-src 'self'; worker-src 'none'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        },
        {
          "key": "Origin-Agent-Cluster",
          "value": "?1"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
